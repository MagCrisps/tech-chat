# ======================================================
# 复制本文件为 .env 后填写真实值（.env 不要提交到 git）
# ======================================================

# ---------- LLM（必须使用 OpenAI 兼容接口）----------
# 例：https://api.openai.com/v1 或 https://api.deepseek.com/v1 或本地 vLLM/Ollama 的地址
OPENAI_BASE_URL=https://api.openai.com/v1
# 你的真实 API Key，切勿写进代码
OPENAI_API_KEY=sk-请替换成你自己的key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- Embedding ----------
# 是否使用本地已有的 embedding 模型：
#   true  -> 只从 EMBEDDING_LOCAL_PATH 加载，完全不联网（适合内网/无外网）
#   false -> 按 EMBEDDING_MODEL_PATH 从 HuggingFace（可用 HF_ENDPOINT 镜像）下载
EMBEDDING_USE_LOCAL=false
# 本地模型目录（仅 EMBEDDING_USE_LOCAL=true 时生效）
# 例：E:/WorkPlace_python/proDoubaoPic/all-MiniLM-L6-v2
EMBEDDING_LOCAL_PATH=
# 远程模型名（仅 EMBEDDING_USE_LOCAL=false 时生效）
# 中文资料建议使用 bge-small-zh-v1.5 / paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# auto / cpu / cuda（auto 会自动判断 cuda 是否可用）
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
# HuggingFace 下载源，国内默认走镜像；如需官方源改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ---------- 向量库 ----------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=tech_knowledge

# ---------- RAG ----------
DATA_DIR=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
# 启动后是否自动打开浏览器
OPEN_BROWSER=true
